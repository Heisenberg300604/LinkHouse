# Neon development branch, pooled connection (hostname contains -pooler)
DATABASE_URL=
# Neon development branch, direct connection for migrations
DIRECT_URL=
# Separate Neon test branch, pooled; NEVER use the development database
TEST_DATABASE_URL=
# Separate Neon test branch, direct migrations connection
TEST_DIRECT_URL=
# Clerk public key for browser components
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key, server only
CLERK_SECRET_KEY=
# Svix signing secret from the Clerk webhook endpoint
CLERK_WEBHOOK_SIGNING_SECRET=
# Clerk route settings
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
# Canonical public URL (no trailing path). Encoded into the shareable QR code, so set it to your real domain in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Primary existing Clerk test account
E2E_CLERK_USER_USERNAME=
E2E_CLERK_USER_PASSWORD=
# Second existing account for isolation tests
E2E_CLERK_USER_B_USERNAME=
E2E_CLERK_USER_B_PASSWORD=
